<script>
(function () {
    var items = document.querySelectorAll('#hfCheck .hf-check-item');
    var count = document.getElementById('hfCount');
    function update() {
        var n = 0;
        items.forEach(function (it) {
            var box = it.querySelector('input');
            it.classList.toggle('is-checked', box.checked);
            if (box.checked) n++;
        });
        if (count) count.textContent = n;
    }
    items.forEach(function (it) {
        it.addEventListener('change', update);
        // also allow clicking the whole card to toggle
        it.addEventListener('click', function (e) {
            if (e.target.tagName !== 'INPUT') {
                var box = it.querySelector('input');
                box.checked = !box.checked;
                update();
            }
        });
    });
})();
</script>
