<tr><td>Heart Bypass (CABG)</td><td style="color:#2e7d32;font-weight:700">$12K-$18K</td><td>$100K-$150K</td><td style="color:#2e7d32">85-88%</td></tr>
<tr><td>Heart Valve Replacement</td><td style="color:#2e7d32;font-weight:700">$10K-$15K</td><td>$80K-$120K</td><td style="color:#2e7d32">85-87%</td></tr>
<tr><td>Knee Replacement</td><td style="color:#2e7d32;font-weight:700">$8K-$12K</td><td>$35K-$50K</td><td style="color:#2e7d32">70-75%</td></tr>
<tr><td>Cancer Treatment</td><td style="color:#2e7d32;font-weight:700">$8K-$20K</td><td>$50K-$100K</td><td style="color:#2e7d32">70-80%</td></tr>
