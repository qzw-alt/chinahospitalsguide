<script>
(function () {
    var items = document.querySelectorAll('#ctCheck .ct-check-item');
    var count = document.getElementById('ctCount');
    function update() {
        var n = 0;
        items.forEach(function (it) {
            var box = it.querySelector('input');
            it.classList.toggle('is-checked', box.checked);
            if (box.checked) n++;
        });
        if (count) count.textContent = n;
    }
    items.forEach(function (it) {
        it.addEventListener('change', update);
        it.addEventListener('click', function (e) {
            // The label already toggles the checkbox natively; toggling again here cancelled it out.
            if (e.target.tagName === 'INPUT' || e.target.closest('label')) return;
            var box = it.querySelector('input');
            box.checked = !box.checked;
            update();
        });
    });
})();
</script>
