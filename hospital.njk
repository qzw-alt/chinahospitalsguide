---
layout: base.njk
pagination:
  data: hospitals
  size: 1
  alias: hospital
permalink: "/hospitals/{{ hospital.id }}/index.html"
eleventyComputed:
  title: "{{ hospital.name }} | China Hospitals Guide"
  description: "{{ hospital.name }} in {{ hospital.city }} — international patient services, procedures, costs and contact. Independent, verified information for treatment in China."
  canonical: "https://chinahospitalsguide.com/hospitals/{{ hospital.id }}/"
  ogTitle: "{{ hospital.name }} | China Hospitals Guide"
  ogDescription: "{{ hospital.city }} hospital for international patients: services, procedures, costs and contact."
activeNav: hospitals
pageStyle: |
  .h-hero { padding:120px 20px 70px; background:linear-gradient(135deg, rgba(12,24,48,.92), rgba(30,60,114,.92)), url('/images/china-hospital.jpg') center/cover no-repeat; color:#fff; }
  .h-shell { max-width:1080px; margin:0 auto; padding:0 20px; }
  .h-kicker { display:inline-block; margin-bottom:14px; padding:7px 13px; border-radius:999px; border:1px solid rgba(255,255,255,.28); background:rgba(255,255,255,.08); font-size:.78rem; text-transform:uppercase; letter-spacing:.06em; }
  .h-hero h1 { color:#fff; margin:0 0 10px; }
  .h-hero p { color:rgba(255,255,255,.88); max-width:680px; }
  .h-metrics { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:14px; margin-top:26px; max-width:760px; }
  .h-metric { background:rgba(255,255,255,.09); border:1px solid rgba(255,255,255,.14); border-radius:14px; padding:14px; }
  .h-metric strong { display:block; font-size:1.1rem; color:#fff; margin-bottom:4px; }
  .h-metric span { font-size:.8rem; color:rgba(255,255,255,.75); }
  .h-actions { display:flex; gap:14px; flex-wrap:wrap; margin-top:28px; }
  .h-section { padding:48px 0 70px; }
  .h-grid { display:grid; grid-template-columns:1.6fr 1fr; gap:28px; align-items:start; }
  @media(max-width:820px){ .h-grid{grid-template-columns:1fr;} }
  .h-card { background:#fff; border:1px solid #e0e7ef; border-radius:16px; padding:24px; box-shadow:0 8px 24px rgba(15,23,42,.06); }
  .h-card h2 { color:#1e3c72; font-size:1.2rem; margin:0 0 14px; }
  .h-row { display:flex; gap:10px; padding:8px 0; border-bottom:1px solid #f0f3f8; font-size:.94rem; color:#3a4556; }
  .h-row:last-child { border-bottom:0; }
  .h-row b { min-width:110px; color:#1e3c72; font-weight:600; flex-shrink:0; }
  .h-evidence { display:inline-block; background:#eef6ef; color:#2e7d32; border:1px solid #c8e6c9; border-radius:999px; padding:1px 9px; font-size:.74rem; font-weight:600; margin:2px 4px 2px 0; }
  .h-proc { padding:9px 0; border-bottom:1px solid #edf1f7; }
  .h-proc:last-child{ border-bottom:0; }
  .h-proc .pprice { color:#2e7d32; font-weight:600; white-space:nowrap; float:right; margin-left:10px; }
  .h-proc .pname { font-weight:600; color:#1e3c72; }
---
<section class="h-hero">
  <div class="h-shell">
    <span class="h-kicker">{{ hospital.city }}{% if hospital.district %} · {{ hospital.district }}{% endif %}</span>
    <h1>{{ hospital.name }}</h1>
    {% if hospital.name_zh %}<p>{{ hospital.name_zh }}</p>{% endif %}
    <div class="h-metrics">
      {% if hospital.grade_3a %}<div class="h-metric"><strong>Grade 3A</strong><span>China's top hospital classification</span></div>{% endif %}
      {% if hospital.jci %}<div class="h-metric"><strong>JCI Accredited</strong><span>International quality certification</span></div>{% endif %}
      {% if hospital.international %}<div class="h-metric"><strong>Intl. Dept.</strong><span>Serves international patients</span></div>{% endif %}
      {% if hospital.trust %}<div class="h-metric"><strong>Verified</strong><span>Data checked {{ hospital.trust.last_verified }}</span></div>{% endif %}
    </div>
    <div class="h-actions">
      <a href="contact-new.html" class="cta-button">Get Matched — Free Case Review</a>
      <a href="hospitals.html" class="cta-button alt">All Hospitals</a>
    </div>
  </div>
</section>

<main class="h-shell">
  <section class="h-section">
    <div class="h-grid">
      <div>
        {% if hospital.rank %}
        <div class="h-card" style="margin-bottom:24px;">
          <h2>Rank &amp; Specialty</h2>
          <div class="h-row"><b>Rank</b><span>{{ hospital.rank }}</span></div>
          {% if hospital.tags %}<div class="h-row"><b>Specialties</b><span>{% for t in hospital.tags %}{{ t | replace('-',' ') | capitalize }}{% if not loop.last %}, {% endif %}{% endfor %}</span></div>{% endif %}
          {% if hospital.estimated_wait_weeks %}<div class="h-row"><b>Est. wait</b><span>{{ hospital.estimated_wait_weeks }}</span></div>{% endif %}
        </div>
        {% endif %}

        {% set hp = hospitalProcedures[hospital.id] %}
        {% if hp %}
        <div class="h-card" style="margin-bottom:24px;">
          <h2>Procedures &amp; Estimated Costs</h2>
          {% for p in hp %}
          <div class="h-proc"><span class="pprice">{{ p.priceText }}</span><span class="pname">{{ p.name }}</span>{% if p.dept %}<div style="font-size:.82rem;color:#66758a;">{{ p.dept }}</div>{% endif %}</div>
          {% endfor %}
          <p style="font-size:.78rem;color:#8893a0;margin:10px 0 0;">Prices are reference ranges; final quotes come from the hospital.</p>
        </div>
        {% endif %}

        {% if hospital.key_specialties %}
        <div class="h-card" style="margin-bottom:24px;">
          <h2>Key Specialties</h2>
          {% for name, desc in hospital.key_specialties %}<div class="h-row"><b>{{ name | replace('-',' ') | capitalize }}</b><span>{{ desc }}</span></div>{% endfor %}
        </div>
        {% endif %}

        {% if hospital.equipment %}
        <div class="h-card" style="margin-bottom:24px;">
          <h2>Equipment &amp; Facilities</h2>
          <p style="font-size:.9rem;color:#4b5565;">{{ hospital.equipment | join(', ') }}</p>
        </div>
        {% endif %}
      </div>

      <div>
        {% if hospital.trust %}
        <div class="h-card" style="margin-bottom:24px;">
          <h2>Data Verification</h2>
          {% set evLabels = { 'official_website':'Official site','public_ranking':'Public ranking','jci_verified':'JCI verified','who_reference':'WHO reference','direct_contact':'Direct contact','direct_channel_partner_documents':'Channel documents','pricing_manual':'Pricing manual','hospital_brochure':'Hospital brochure' } %}
          <div class="h-row"><b>Verified</b><span>✓ {{ hospital.trust.last_verified }}{% if hospital.trust.data_source %} · {{ hospital.trust.data_source | replace('_',' ') | capitalize }}{% endif %}</span></div>
          {% if hospital.trust.cross_validated %}<div class="h-row"><b>Evidence</b><span>{% for e in hospital.trust.cross_validated %}<span class="h-evidence">{{ evLabels[e] or (e | replace('_',' ') | capitalize) }} ✓</span>{% endfor %}</span></div>{% endif %}
          {% if hospital.trust.level %}<div class="h-row"><b>Trust</b><span>{{ hospital.trust.level | replace('_',' ') | capitalize }}</span></div>{% endif %}
          <p style="font-size:.8rem;margin:12px 0 0;"><a href="how-we-choose-hospitals.html" style="color:#1e3c72;font-weight:600;">How we verify →</a></p>
        </div>
        {% endif %}

        <div class="h-card" style="margin-bottom:24px;">
          <h2>Contact &amp; Location</h2>
          {% if hospital.address %}<div class="h-row"><b>Address</b><span>{{ hospital.name_zh }}<br>{{ hospital.address }}</span></div>{% endif %}
          {% if hospital.international_phone %}<div class="h-row"><b>Intl. phone</b><span>{{ hospital.international_phone }}</span></div>{% endif %}
          {% if hospital.phone %}<div class="h-row"><b>Phone</b><span>{{ hospital.phone }}</span></div>{% endif %}
          {% if hospital.email %}<div class="h-row"><b>Email</b><span>{{ hospital.email }}</span></div>{% endif %}
          {% if hospital.website %}<div class="h-row"><b>Website</b><span><a href="{{ hospital.website }}" target="_blank" rel="noopener" style="color:#1e3c72;">{{ hospital.website }}</a></span></div>{% endif %}
          {% if hospital.airport_info %}<div class="h-row"><b>Airport</b><span>✈️ {{ hospital.airport_info }}</span></div>{% endif %}
        </div>

        {% if hospital.international_dept %}
        <div class="h-card" style="margin-bottom:24px;">
          <h2>International Patient Services</h2>
          {% if hospital.international_dept.name %}<div class="h-row"><b>Dept</b><span>{{ hospital.international_dept.name }}</span></div>{% endif %}
          {% if hospital.international_dept.languages %}<div class="h-row"><b>Languages</b><span>{{ hospital.international_dept.languages | join(', ') }}</span></div>{% endif %}
          {% if hospital.international_dept.phone %}<div class="h-row"><b>Phone</b><span>{{ hospital.international_dept.phone }}</span></div>{% endif %}
          {% if hospital.international_dept.email %}<div class="h-row"><b>Email</b><span>{{ hospital.international_dept.email }}</span></div>{% endif %}
          {% if hospital.international_dept.services %}<div class="h-row"><b>Services</b><span>{{ hospital.international_dept.services }}</span></div>{% endif %}
        </div>
        {% endif %}

        {% if hospital.payment_methods %}
        <div class="h-card">
          <h2>Accepted Payments</h2>
          <p style="font-size:.9rem;color:#4b5565;">{{ hospital.payment_methods | join(' · ') }}</p>
        </div>
        {% endif %}
      </div>
    </div>

    <div class="h-card" style="margin-top:24px;text-align:center;">
      <h2>Planning treatment at {{ hospital.name }}?</h2>
      <p style="color:#4b5565;">Get matched to this hospital and 1–2 others selected for your case — free case review, response within 24 hours.</p>
      <div class="h-actions" style="justify-content:center;">
        <a href="contact-new.html" class="cta-button">Start Free Case Review</a>
        <a href="pricing.html" class="cta-button alt">View Pricing</a>
      </div>
    </div>
  </section>
</main>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Hospital",
  "name": "{{ hospital.name | e }}",
  {% if hospital.name_zh %}"alternateName": "{{ hospital.name_zh | e }}",{% endif %}
  "url": "https://chinahospitalsguide.com/hospitals/{{ hospital.id }}/",
  {% if hospital.address %}"address": { "@type": "PostalAddress", "streetAddress": "{{ hospital.address | e }}", "addressLocality": "{{ hospital.city | e }}", "addressCountry": "CN" },{% endif %}
  {% if hospital.phone %}"telephone": "{{ hospital.phone | e }}",{% endif %}
  "medicalSpecialty": {{ hospital.tags | dump | safe }}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "{{ hospital.name | e }}",
  "url": "https://chinahospitalsguide.com/hospitals/{{ hospital.id }}/",
  "isPartOf": { "@type": "WebSite", "name": "China Hospitals Guide", "url": "https://chinahospitalsguide.com" }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://chinahospitalsguide.com/" },
    { "@type": "ListItem", "position": 2, "name": "Hospitals", "item": "https://chinahospitalsguide.com/hospitals.html" },
    { "@type": "ListItem", "position": 3, "name": "{{ hospital.name | e }}", "item": "https://chinahospitalsguide.com/hospitals/{{ hospital.id }}/" }
  ]
}
</script>
