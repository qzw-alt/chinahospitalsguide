<section class="case-hero">
        <h1>Start your case review</h1>
        <p>Tell us about your case and we will help you understand the right next step before you commit to more support.</p>
    </section>

    <main class="case-shell">
        <div class="case-intro">
            <p><strong>Use this form if:</strong> you are a new patient, want guidance before choosing a package, or already paid and need to hand off your case details.</p>
            <p><strong>Tip:</strong> If you already paid, mention the package in your message so we can move faster.</p>
        </div>

        <div class="case-grid">
            <div class="case-panel">
                <h2>Case review form</h2>
                <form id="consultForm" action="https://formspree.io/{{ site.formspree.caseReview }}" method="POST">
                    <input type="hidden" name="_subject" value="New Case Review — China Hospitals Guide">
                    <input type="hidden" name="form_type" value="case_review">
                    <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off">
                    <div class="form-group">
                        <label>Full Name <span>*</span></label>
                        <input type="text" id="firstname" name="firstname" required placeholder="John Smith">
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Email <span>*</span></label>
                            <input type="email" id="email" name="email" required placeholder="john@example.com">
                        </div>
                        <div class="form-group">
                            <label>Email / Phone / WhatsApp / Telegram</label>
                            <input type="tel" id="phone" name="phone" placeholder="+1 234 567 8900">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Country <span>*</span></label>
                        <select id="country" name="country" required>
                            <option value="">Select your country...</option>
                            <option value="United States">United States</option>
                            <option value="United Kingdom">United Kingdom</option>
                            <option value="Canada">Canada</option>
                            <option value="Australia">Australia</option>
                            <option value="Japan">Japan</option>
                            <option value="South Korea">South Korea</option>
                            <option value="Germany">Germany</option>
                            <option value="France">France</option>
                            <option value="Singapore">Singapore</option>
                            <option value="Malaysia">Malaysia</option>
                            <option value="Indonesia">Indonesia</option>
                            <option value="Philippines">Philippines</option>
                            <option value="Thailand">Thailand</option>
                            <option value="Vietnam">Vietnam</option>
                            <option value="Russia">Russia</option>
                            <option value="Middle East">Middle East</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Medical Condition / Treatment Needed <span>*</span></label>
                        <select id="treatment_category" name="treatment_category" required>
                            <option value="">Select treatment type...</option>
                            <option value="Cancer Treatment / Oncology">Cancer Treatment / Oncology</option>
                            <option value="Proton Therapy">Proton Therapy</option>
                            <option value="Cardiac Surgery / Cardiology">Cardiac Surgery / Cardiology</option>
                            <option value="Orthopedics / Joint Replacement">Orthopedics / Joint Replacement</option>
                            <option value="Neurology / Neurosurgery">Neurology / Neurosurgery</option>
                            <option value="IVF / Fertility Treatment">IVF / Fertility Treatment</option>
                            <option value="Plastic / Cosmetic Surgery">Plastic / Cosmetic Surgery</option>
                            <option value="Dental Treatment">Dental Treatment</option>
                            <option value="Eye Surgery / LASIK">Eye Surgery / LASIK</option>
                            <option value="Traditional Chinese Medicine">Traditional Chinese Medicine</option>
                            <option value="General Health Checkup">General Health Checkup</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="form-row lead-row">
                        <div class="form-group">
                            <label>Budget Range</label>
                            <select id="budget" name="budget">
                                <option value="">Select budget...</option>
                                <option value="Under $5k">Under $5k</option>
                                <option value="$5k–$15k">$5k–$15k</option>
                                <option value="$15k–$50k">$15k–$50k</option>
                                <option value="$50k+">$50k+</option>
                                <option value="Not sure">Not sure</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Expected Timeline</label>
                            <select id="timeline" name="timeline">
                                <option value="">Select timeline...</option>
                                <option value="ASAP">ASAP</option>
                                <option value="Within 1 month">Within 1 month</option>
                                <option value="1–3 months">1–3 months</option>
                                <option value="3+ months">3+ months</option>
                                <option value="Not sure">Not sure</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Diagnosis Status</label>
                            <select id="diagnosis_status" name="diagnosis_status">
                                <option value="">Select status...</option>
                                <option value="Diagnosed">Diagnosed</option>
                                <option value="Suspected">Suspected</option>
                                <option value="Not diagnosed">Not diagnosed</option>
                                <option value="Seeking second opinion">Seeking second opinion</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Describe Your Medical Situation <span>*</span></label>
                        <textarea id="medical_details" name="medical_details" required placeholder="Describe your condition, what you need, your timeline, and whether you already paid for a package."></textarea>
                    </div>

                    <div class="form-group">
                        <label>Do you have medical records (reports, imaging, pathology)?</label>
                        <div class="checkbox-group" style="display:flex;flex-wrap:wrap;gap:12px;margin-top:4px;">
                            <label style="display:flex;align-items:center;gap:6px;font-weight:400;cursor:pointer;font-size:0.93rem;color:var(--text);">
                                <input type="checkbox" name="has_records" value="Yes - will send via WhatsApp/Telegram/email"> Yes — I'll send them by WhatsApp/Telegram/email
                            </label>
                            <label style="display:flex;align-items:center;gap:6px;font-weight:400;cursor:pointer;font-size:0.93rem;color:var(--text);">
                                <input type="checkbox" name="has_records" value="Yes - described in the form above"> Yes — described in the form above
                            </label>
                            <label style="display:flex;align-items:center;gap:6px;font-weight:400;cursor:pointer;font-size:0.93rem;color:var(--text);">
                                <input type="checkbox" name="has_records" value="No - not yet"> No — not yet
                            </label>
                        </div>
                        <p style="font-size:0.82rem;color:#66758a;margin-top:8px;">For privacy, please don't attach sensitive files to this form. After submitting, send records directly by email (<a href="mailto:contact@chinahospitalsguide.com" style="color:#1e3c72;font-weight:600;">contact@chinahospitalsguide.com</a>), <a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener" style="color:#25D366;font-weight:600;">WhatsApp</a>, or <a href="https://t.me/chinahospitalguide" target="_blank" rel="noopener" style="color:#0088cc;font-weight:600;">Telegram</a>.</p>
                    </div>

                    <div class="form-group">
                        <label>How did you hear about us?</label>
                        <select id="source" name="source">
                            <option value="">Select...</option>
                            <option value="Google Search">Google Search</option>
                            <option value="Social Media">Social Media</option>
                            <option value="Friend / Referral">Friend / Referral</option>
                            <option value="Medical Tourism Directory">Medical Tourism Directory</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>What do you need help with? <span>*</span></label>
                        <div class="checkbox-group" style="display:flex;flex-wrap:wrap;gap:12px;margin-top:4px;">
                            <label style="display:flex;align-items:center;gap:6px;font-weight:400;cursor:pointer;font-size:0.93rem;color:var(--text);">
                                <input type="checkbox" name="help_type" value="Hospital search / shortlist"> Hospital search / shortlist
                            </label>
                            <label style="display:flex;align-items:center;gap:6px;font-weight:400;cursor:pointer;font-size:0.93rem;color:var(--text);">
                                <input type="checkbox" name="help_type" value="Appointment coordination"> Appointment coordination
                            </label>
                            <label style="display:flex;align-items:center;gap:6px;font-weight:400;cursor:pointer;font-size:0.93rem;color:var(--text);">
                                <input type="checkbox" name="help_type" value="Airport pickup"> Airport pickup
                            </label>
                            <label style="display:flex;align-items:center;gap:6px;font-weight:400;cursor:pointer;font-size:0.93rem;color:var(--text);">
                                <input type="checkbox" name="help_type" value="Travel / route planning"> Travel / route planning
                            </label>
                            <label style="display:flex;align-items:center;gap:6px;font-weight:400;cursor:pointer;font-size:0.93rem;color:var(--text);">
                                <input type="checkbox" name="help_type" value="Not sure yet"> Not sure yet
                            </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Preferred Service Path <span>*</span></label>
                        <div class="radio-group">
                            <label class="radio-item">
                                <input type="radio" name="package" value="Not sure yet - recommend a package" required>
                                <span><strong>Recommend a package for me</strong> - best for new visitors who have not paid yet</span>
                            </label>
                            <label class="radio-item">
                                <input type="radio" name="package" value="L1 — Hospital Shortlist ($49)">
                                <span><strong>L1 — Hospital Shortlist ($49)</strong> — 2-3 hospital matches + cost comparison + transport guidance</span>
                            </label>
                            <label class="radio-item">
                                <input type="radio" name="package" value="L2 — Hospital Verification ($149)">
                                <span><strong>L2 — Hospital Verification ($149)</strong> — send your case to 2-3 hospitals, translate responses, connect you directly</span>
                            </label>
                            <label class="radio-item">
                                <input type="radio" name="package" value="L3 — Full Journey Management ($399)">
                                <span><strong>L3 — Full Journey Management ($399)</strong> — includes L2 + records, visa letter, appointments, airport pickup, ongoing coordination</span>
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="submit-btn" id="submitBtn">Submit Case Review</button>
                    <p class="privacy-note">Your information is used only to review your case and recommend or deliver the correct service path.</p>
                    <div id="formError" role="alert" style="display:none;margin-top:16px;padding:16px 18px;background:#fdecea;border:1px solid #f5c6c0;border-radius:10px;color:#b3261e;font-size:0.95rem;">
                        <p style="margin:0 0 8px;font-weight:700;">Something went wrong submitting your case.</p>
                        <p style="margin:0;">Please try again, or contact us directly so we don't miss your case:</p>
                        <p style="margin:10px 0 0;">
                            <a href="mailto:contact@chinahospitalsguide.com" style="color:#0088cc;font-weight:600;">Email</a>
                            &nbsp;·&nbsp; <a href="https://wa.me/{{ site.whatsapp }}" style="color:#25D366;font-weight:600;" target="_blank" rel="noopener">WhatsApp</a>
                            &nbsp;·&nbsp; <a href="https://t.me/chinahospitalguide" style="color:#0088cc;font-weight:600;" target="_blank" rel="noopener">Telegram @chinahospitalguide</a>
                            &nbsp;·&nbsp; WeChat: <strong>chinahospitalguide</strong>
                        </p>
                    </div>
                </form>

                <div class="success-message" id="successMessage">
                    <div class="success-icon">✅</div>
                    <h3>Case submitted</h3>
                    <p>We have received your details and will review your case shortly.</p>
                    <ul class="success-next">
                        <li>Check your email for a confirmation message.</li>
                        <li>We usually reply within 4 business hours.</li>
                        <li>For faster response, email us or message us on WhatsApp, Telegram (@chinahospitalguide) or WeChat (chinahospitalguide).</li>
                        <li>If you have medical records, send them to us by email, WhatsApp, or Telegram — we'll review your case faster.</li>
                    </ul>
                    <div style="background:#f0f6ff;border-radius:16px;padding:20px;margin:24px auto;max-width:480px;text-align:center;">
                        <p style="font-weight:700;color:#1e3c72;margin:0 0 8px;">💬 Want a faster response?</p>
                        <p style="font-size:0.9rem;color:#4b5565;margin:0 0 16px;">Message us directly — we typically reply within minutes during business hours.</p>
                        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
                            <a href="mailto:contact@chinahospitalsguide.com" class="cta-button" style="background:linear-gradient(135deg,#1e3c72 0%,#2a4f8f 100%);font-size:0.9rem;padding:12px 20px;" target="_blank" rel="noopener">📧 Email</a>
                            <a href="https://wa.me/{{ site.whatsapp }}" class="cta-button" style="background:linear-gradient(135deg,#25D366 0%,#1DA851 100%);font-size:0.9rem;padding:12px 20px;" target="_blank" rel="noopener">💬 WhatsApp</a>
                            <a href="https://t.me/chinahospitalguide" class="cta-button" style="background:linear-gradient(135deg,#0088cc 0%,#006699 100%);font-size:0.9rem;padding:12px 20px;" target="_blank" rel="noopener">📨 Telegram</a>
                            <span class="cta-button" style="background:linear-gradient(135deg,#07C160 0%,#06AD56 100%);font-size:0.9rem;padding:12px 20px;cursor:default;">💬 WeChat: chinahospitalguide</span>
                        </div>
                        <p style="font-size:0.75rem;color:#999;margin:12px 0 0;">Add us on WeChat or Telegram — we typically reply within minutes during business hours.</p>
                    </div>
                    <p style="margin:20px 0 12px;font-weight:700;color:#1e3c72;">Already know which package you need?</p>
                    <div class="success-actions">
                        <a href="pricing.html" class="cta-button" style="background:linear-gradient(135deg,#b78a42 0%,#d4a84b 100%);">Choose Package &amp; Pay →</a>
                        <a href="index.html" class="cta-button" style="background:transparent;color:#1e3c72;border:2px solid #1e3c72;">Back to Home</a>
                    </div>
                </div>
            </div>

            <div class="case-panel">
                <h2>Two ways to get started</h2>
                <div style="background:#f0f6ff;border-radius:16px;padding:20px;margin-bottom:20px;">
                    <p style="margin:0 0 8px;font-weight:700;color:#1e3c72;">✅ Not sure yet — Let us review your case first</p>
                    <p style="margin:0;font-size:0.95rem;color:#4b5565;">We review your case details, recommend the right package, and guide you on next steps.</p>
                </div>
                <div style="background:#fff8ef;border:1px solid #e8d5a8;border-radius:16px;padding:20px;margin-bottom:20px;">
                    <p style="margin:0 0 8px;font-weight:700;color:#b78a42;">💰 Already know which package you need — Pay directly</p>
                    <p style="margin:0 0 12px;font-size:0.95rem;color:#4b5565;">Go straight to pricing, choose your package, and pay with PayPal. Return here after payment if needed.</p>
                    <a href="pricing.html" style="display:inline-block;background:linear-gradient(135deg,#b78a42 0%,#d4a84b 100%);color:white;padding:10px 24px;border-radius:8px;text-decoration:none;font-weight:700;">Pay Now →</a>
                </div>
                <div style="background:#e8f5e9;border:1px solid #a5d6a7;border-radius:16px;padding:20px;margin-bottom:20px;">
                    <p style="margin:0 0 8px;font-weight:700;color:#2e7d32;">💬 Prefer to chat first?</p>
                    <p style="margin:0 0 12px;font-size:0.95rem;color:#4b5565;">Message us on Telegram or WeChat. We typically reply within minutes during business hours.</p>
                    <div style="display:flex;gap:10px;flex-wrap:wrap;">
                        <a href="https://wa.me/{{ site.whatsapp }}" style="display:inline-block;background:#25D366;color:white;padding:10px 20px;border-radius:8px;text-decoration:none;font-weight:700;font-size:0.9rem;" target="_blank" rel="noopener">💬 WhatsApp</a>
                        <a href="https://t.me/chinahospitalguide" style="display:inline-block;background:#0088cc;color:white;padding:10px 20px;border-radius:8px;text-decoration:none;font-weight:700;font-size:0.9rem;" target="_blank" rel="noopener">📨 Telegram</a>
                        <span style="display:inline-flex;align-items:center;gap:4px;background:#07C160;color:white;padding:10px 20px;border-radius:8px;font-weight:700;font-size:0.9rem;">💬 WeChat: <code style="background:rgba(255,255,255,0.2);padding:2px 8px;border-radius:4px;">chinahospitalguide</code></span>
                    </div>
                    <p style="margin:12px 0 0;font-size:0.85rem;color:#666;">Mon-Fri 9:00-18:00 GMT+8</p>
                </div>
                <div class="link-actions" style="margin-top:24px; display:flex; flex-wrap:wrap; gap:16px;">
                    <a href="contact.html" class="cta-button">Other Contact Options</a>
                </div>
            </div>
        </div>
    </main>

    <script>
    (function() {
        var form = document.getElementById('consultForm');
        if (!form) return;
        var submitBtn = document.getElementById('submitBtn');
        var success = document.getElementById('successMessage');
        var errorBox = document.getElementById('formError');

        // Single source of truth: the form's action URL carries the Formspree form id.
        // Replace with a dedicated case-review form id if you create one (currently reuses
        // the newsletter endpoint so submissions work immediately).
        var action = form.getAttribute('action') || '';

        // Prefill from URL query params (?treatment=...&country=...&budget=...&source=...)
        function prefillFromQuery() {
            var params = new URLSearchParams(window.location.search);
            var selMap = { treatment: 'treatment_category', country: 'country', budget: 'budget', timeline: 'timeline', source: 'source' };
            Object.keys(selMap).forEach(function(key) {
                var val = params.get(key);
                if (!val) return;
                var sel = document.getElementById(selMap[key]);
                if (!sel) return;
                for (var i = 0; i < sel.options.length; i++) {
                    if (sel.options[i].value === val) { sel.selectedIndex = i; return; }
                }
                for (var j = 0; j < sel.options.length; j++) {
                    if (sel.options[j].value && val.toLowerCase().indexOf(sel.options[j].value.toLowerCase()) !== -1) { sel.selectedIndex = j; return; }
                }
            });
            var pkg = params.get('package');
            if (pkg) {
                document.querySelectorAll('input[name="package"]').forEach(function(r) {
                    if (r.value && r.value.toLowerCase().indexOf(pkg.toLowerCase()) !== -1) r.checked = true;
                });
            }
        }
        prefillFromQuery();

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = 'Submitting...';
            }
            if (errorBox) errorBox.style.display = 'none';

            var data = new FormData(form);
            var name = (data.get('firstname') || '').trim();
            var treatment = data.get('treatment_category') || '';
            data.set('_subject', 'New Case Review' + (name ? ' — ' + name : '') + (treatment ? ' (' + treatment + ')' : ''));

            fetch(action, {
                method: 'POST',
                body: data,
                headers: { 'Accept': 'application/json' }
            }).then(function(res) {
                if (!res.ok) throw new Error('Formspree error ' + res.status);
                if (typeof gtag === 'function') {
                    gtag('event', 'generate_lead', { page_location: location.pathname });
                    gtag('event', 'conversion', {
                        send_to: 'G-RVYZENK472',
                        event_category: 'form',
                        event_label: 'case_review_submitted',
                        page_location: location.pathname
                    });
                }
                form.style.display = 'none';
                if (success) {
                    success.classList.add('visible');
                    success.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }).catch(function() {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Submit Case Review';
                }
                if (errorBox) errorBox.style.display = 'block';
            });
        });
    })();
    </script>
