<section class="calc-hero">
  <h1>What will your treatment actually cost in China?</h1>
  <p>Pick a procedure, choose a city and hospital tier, and add the coordination you need. Get an instant estimate — China vs US/UK, with your savings.</p>
</section>

<div class="calc-shell">
  <div class="calc-card">
    <div class="calc-step">
      <label for="procedure">1. Procedure <span class="hint">(total in-hospital cost, USD)</span></label>
      <select id="procedure" aria-label="Procedure"></select>
    </div>
    <div class="calc-step">
      <label for="city">2. City</label>
      <select id="city" aria-label="City">
        <option value="beijing">Beijing — top-tier hospitals (high cost)</option>
        <option value="shanghai">Shanghai — international standard (high cost)</option>
        <option value="guangzhou">Guangzhou — good value (medium)</option>
        <option value="shenzhen">Shenzhen — modern, newest equipment (medium)</option>
        <option value="chengdu">Chengdu — best value, West China Hospital (low)</option>
      </select>
    </div>
    <div class="calc-step">
      <label for="tier">3. Hospital tier</label>
      <select id="tier" aria-label="Hospital tier">
        <option value="top">Grade 3A top center (e.g. PUMC, Fuwai) — baseline</option>
        <option value="jci">JCI-accredited international department (−5%)</option>
        <option value="value">Regional value hospital (−20%)</option>
      </select>
    </div>
    <div class="calc-step">
      <label for="pkg">4. Coordination package <span class="hint">(optional, added on top)</span></label>
      <select id="pkg" aria-label="Coordination package">
        <option value="0">None — I'll go on my own</option>
        <option value="49">L1 Hospital Shortlist — $49</option>
        <option value="149">L2 Hospital Verification — $149</option>
        <option value="399">L3 Full Journey Management — $399</option>
      </select>
    </div>
    <div class="calc-step">
      <label>5. Add-ons <span class="hint">(optional)</span></label>
      <div class="addon-grid">
        <label class="addon-opt"><input type="checkbox" value="80" data-addon><span><span class="name">Airport pickup + transfer</span><span class="price">+$80</span></span></label>
        <label class="addon-opt"><input type="checkbox" value="50" data-addon><span><span class="name">Medical records translation</span><span class="price">+$50</span></span></label>
        <label class="addon-opt"><input type="checkbox" value="1280" data-addon><span><span class="name">Family companion (≈$80/day × 16 days)</span><span class="price">+$1,280</span></span></label>
      </div>
    </div>
  </div>

  <div class="result-panel" id="result">
    <h2>Your estimate</h2>
    <p class="note">Estimated range — not a quote. Final pricing depends on your diagnosis, materials, and hospital assessment.</p>
    <div class="result-grid">
      <div class="result-box"><div class="label">China (all-in, est.)</div><div class="value" id="r-china">—</div></div>
      <div class="result-box"><div class="label">US (comparable)</div><div class="value" id="r-us">—</div></div>
      <div class="result-box"><div class="label">You could save</div><div class="value savings" id="r-save">—</div></div>
      <div class="result-box"><div class="label">UK private (reference)</div><div class="value" id="r-uk">—</div></div>
    </div>
    <div class="savings-bar"><div id="savings-fill" style="width:0%"></div></div>
    <a class="calc-cta" id="cta-link" href="/contact-new.html?source=calculator">Get an itemized quote →</a>
  </div>

  <p class="disclaimer" style="margin-top:18px">Estimates are based on published price research at top Chinese hospitals. They cover the procedure and hospital stay; international flights, visa, and non-hospital accommodation are not included. We verify current figures with each hospital before you travel.</p>
</div>

<script>
(function () {
  var DATA = {
    "knee": { name: "Knee Replacement", china: [8000, 12000], us: [35000, 50000], uk: [25000, 35000] },
    "hip": { name: "Hip Replacement", china: [8000, 12000], us: [35000, 50000], uk: [25000, 35000] },
    "cabg": { name: "Heart Bypass (CABG)", china: [12000, 18000], us: [100000, 150000], uk: [35000, 50000] },
    "valve": { name: "Heart Valve Replacement", china: [10000, 15000], us: [80000, 120000], uk: [30000, 45000] },
    "cancer": { name: "Cancer Treatment", china: [8000, 20000], us: [50000, 100000], uk: [20000, 40000] },
    "spine": { name: "Spine Surgery", china: [10000, 18000], us: [40000, 80000], uk: [25000, 50000] },
    "ivf": { name: "IVF Treatment", china: [3000, 8000], us: [15000, 25000], uk: [8000, 15000] },
    "cataract": { name: "Cataract Surgery (per eye)", china: [800, 1500], us: [3000, 6000], uk: [2500, 4000] },
    "lasik": { name: "LASIK (both eyes)", china: [1600, 3000], us: [4000, 7000], uk: [3000, 5000] }
  };
  var CITY = { beijing: 1.0, shanghai: 1.0, guangzhou: 0.85, shenzhen: 0.85, chengdu: 0.70 };
  var TIER = { top: 1.0, jci: 0.95, value: 0.80 };

  var sel = document.getElementById('procedure');
  Object.keys(DATA).forEach(function (k) {
    var o = document.createElement('option');
    o.value = k; o.textContent = DATA[k].name;
    sel.appendChild(o);
  });

  function fmt(n) {
    if (n >= 1000) return '$' + Math.round(n / 1000) + 'K';
    return '$' + n;
  }
  function fmtRange(a) {
    return fmt(a[0]) + ' – ' + fmt(a[1]);
  }

  function recalc() {
    var key = sel.value;
    var d = DATA[key];
    if (!d) return;
    var cm = CITY[document.getElementById('city').value];
    var tm = TIER[document.getElementById('tier').value];
    var pkg = parseInt(document.getElementById('pkg').value, 10) || 0;
    var add = 0;
    document.querySelectorAll('[data-addon]:checked').forEach(function (c) { add += parseInt(c.value, 10); });

    var chinaLow = Math.round(d.china[0] * cm * tm) + pkg + add;
    var chinaHigh = Math.round(d.china[1] * cm * tm) + pkg + add;

    document.getElementById('r-china').textContent = fmtRange([chinaLow, chinaHigh]);
    document.getElementById('r-us').textContent = fmtRange(d.us);
    document.getElementById('r-uk').textContent = '£' + Math.round(d.uk[0] / 1000) + 'K – £' + Math.round(d.uk[1] / 1000) + 'K';

    var usMid = (d.us[0] + d.us[1]) / 2;
    var chinaMid = (chinaLow + chinaHigh) / 2;
    var savePct = Math.max(0, Math.round((usMid - chinaMid) / usMid * 100));
    document.getElementById('r-save').textContent = savePct + '%';
    document.getElementById('savings-fill').style.width = savePct + '%';
    document.getElementById('cta-link').href = '/contact-new.html?source=calculator&proc=' + encodeURIComponent(d.name);
  }

  ['procedure', 'city', 'tier', 'pkg'].forEach(function (id) {
    document.getElementById(id).addEventListener('change', recalc);
  });
  document.querySelectorAll('[data-addon]').forEach(function (c) { c.addEventListener('change', recalc); });

  recalc();
})();
</script>
