---
<header class="page-header">
        <span class="hero-kicker">Hospitals in China for international patients</span>
        <h1>50+ Hospitals in China for Foreigners &amp; International Patients</h1>
        <p>Compare hospitals in Beijing, Shanghai, Guangzhou, Shenzhen, Foshan, and other major cities by specialty, international support, and practical planning details.</p>
        <div class="hero-metrics">
            <div class="hero-metric"><strong>52 hospitals</strong><span>Across major cities and specialties</span></div>
            <div class="hero-metric"><strong>City + specialty view</strong><span>Built for faster shortlisting before you travel</span></div>
        </div>
    </header>

    <section class="filter-section">
        <div class="filter-container">
            <div class="filter-shell">
            <div class="search-box">
                <input type="text" id="searchInput" placeholder="Search hospitals, cities, or specialties...">
            </div>
            <div class="region-tabs" id="regionTabs">
                <button class="region-tab active" data-region="all">🌐 All Regions</button>
                <button class="region-tab" data-region="beijing">🇨🇳 Beijing</button>
                <button class="region-tab" data-region="shanghai">🇨🇳 Shanghai</button>
                <button class="region-tab" data-region="guangzhou">🇨🇳 Guangzhou</button>
                <button class="region-tab" data-region="prd">🇨🇳 Pearl River Delta</button>
            </div>
            <div class="specialty-tags" id="specialtyTags"></div>
            </div>
        </div>
    </section>

    <div class="results-count" id="resultsCount">Showing all 52 hospitals</div>
    <div style="max-width:1160px;margin:4px auto 0;padding:0 20px;text-align:center;color:#8a94a3;font-size:0.8rem">Each hospital shows when its data was last verified.</div>

    <div class="disclaimer">
        <div class="disclaimer-box">
            <p><strong>Disclaimer:</strong> Hospital information and cost references are based on publicly available information and may change. Use this page to compare options first, then confirm current details with the hospital or ask us to help you narrow the shortlist.</p>
        </div>
    </div>

    <section class="assist-strip">
        <div class="assist-box">
            <div>
                <h2>Need help narrowing the shortlist?</h2>
                <p>If you already know the specialty you need, we can help you compare hospitals, likely costs, and the next practical step before you travel.</p>
            </div>
            <div class="assist-actions">
                <a href="contact-new.html" class="assist-btn primary">Start Case Review</a>
                <a href="services.html" class="assist-btn secondary">See Services</a>
            </div>
        </div>
    </section>

    <main class="hospitals-section">
        <div class="hospital-grid" id="hospitalGrid"></div>
    </main>

    <script>
    (function() {
        var allHospitals = [];
        var activeRegion = 'all';
        var activeSearch = '';
        var activeSpecialty = '';

        var grid = document.getElementById('hospitalGrid');
        var searchInput = document.getElementById('searchInput');
        var regionTabs = document.getElementById('regionTabs');
        var specialtyTags = document.getElementById('specialtyTags');
        var resultsCount = document.getElementById('resultsCount');

        var procedureByHospital = {};
        function buildProcedureMap(procs) {
            procedureByHospital = {};
            (procs || []).forEach(function(p) {
                (p.hospitals || []).forEach(function(hp) {
                    if (!procedureByHospital[hp.hospital_id]) procedureByHospital[hp.hospital_id] = [];
                    procedureByHospital[hp.hospital_id].push({
                        name: p.name,
                        price: fmtPrice(hp.price_range_usd),
                        dept: hp.department || ''
                    });
                });
            });
        }
        function fmtPrice(r) {
            if (!r) return '';
            var lo = r.low ? '$' + Number(r.low).toLocaleString() : '';
            var hi = r.high ? '$' + Number(r.high).toLocaleString() : '';
            if (lo && hi && hi !== lo) return lo + '–' + hi;
            return hi || lo;
        }

        function fetchHospitals() {
            grid.innerHTML = '<p style="text-align:center;color:#888;padding:2rem;grid-column:1/-1">Loading hospitals...</p>';
            Promise.all([
                fetch('/api/v1/hospitals.json').then(function(r) { return r.json(); }),
                fetch('/api/v1/procedures.json').then(function(r) { return r.json(); }).catch(function() { return { procedures: [] }; })
            ]).then(function(results) {
                allHospitals = results[0].hospitals || [];
                buildProcedureMap(results[1].procedures || []);
                buildSpecialtyTags();
                render();
            })
            .catch(function(e) {
                grid.innerHTML = '<p style="text-align:center;color:#c00;padding:2rem;grid-column:1/-1">Failed to load hospital data. Please try again later.</p>';
                console.error(e);
            });
        }

        var REGION_MAP = {
            'all': [],
            'beijing': ['Beijing'],
            'shanghai': ['Shanghai'],
            'guangzhou': ['Guangzhou'],
            'prd': ['Guangzhou', 'Shenzhen', 'Foshan', 'Zhuhai', 'Dongguan']
        };

        function getSpecialties() {
            var set = {};
            allHospitals.forEach(function(h) {
                (h.tags || []).forEach(function(t) {
                    set[t] = (set[t] || 0) + 1;
                });
            });
            return Object.keys(set).sort();
        }

        function buildSpecialtyTags() {
            var specs = getSpecialties();
            var html = '<button class="specialty-tag active" data-specialty="">All Specialties</button>';
            specs.forEach(function(s) {
                html += '<button class="specialty-tag" data-specialty="' + s + '">' + formatTag(s) + '</button>';
            });
            specialtyTags.innerHTML = html;
        }

        function formatTag(t) {
            return t.replace(/-/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
        }

        function filterHospitals() {
            return allHospitals.filter(function(h) {
                if (activeRegion === 'all') { /* pass */ }
                else {
                    var cities = REGION_MAP[activeRegion] || [];
                    if (cities.length && cities.indexOf(h.city) === -1) return false;
                }
                if (activeSpecialty && h.tags.indexOf(activeSpecialty) === -1) return false;
                if (activeSearch) {
                    var q = activeSearch.toLowerCase();
                    var haystack = (h.name + ' ' + h.name_zh + ' ' + h.city + ' ' + (h.tags||[]).join(' ') + ' ' + (h.rank||'')).toLowerCase();
                    if (haystack.indexOf(q) === -1) return false;
                }
                return true;
            });
        }

        function render() {
            var filtered = filterHospitals();
            resultsCount.textContent = 'Showing ' + filtered.length + ' of ' + allHospitals.length + ' hospitals';

            if (filtered.length === 0) {
                grid.innerHTML = '<p style="text-align:center;color:#888;padding:3rem;grid-column:1/-1">No hospitals match your filters. Try a different search or region.</p>';
                return;
            }

            var cityImages = {
                'Beijing': 'images/hospitals/beijing-city.jpg',
                'Shanghai': 'images/hospitals/shanghai-city.jpg',
                'Guangzhou': 'images/hospitals/guangzhou-city.jpg'
            };

            grid.innerHTML = filtered.map(function(h) {
                var imageHtml = '';
                if (cityImages[h.city]) {
                    imageHtml = '<img class="hospital-image" src="' + cityImages[h.city] + '" alt="' + h.city + '" loading="lazy">';
                } else {
                    var colors = ['#1e3c72','#2a5298','#17345f','#345d9e','#4169b6'];
                    var color = colors[Math.abs(hashCode(h.id || h.name)) % colors.length];
                    imageHtml = '<div class="hospital-image-placeholder" style="background:' + color + '">🏥 ' + h.city + '</div>';
                }

                var badges = '';
                if (h.grade_3a) badges += '<span class="badge badge-3a">🏥 Grade 3A</span>';
                if (h.jci) badges += '<span class="badge badge-jci">JCI Accredited</span>';
                if (h.international) badges += '<span class="badge badge-intl">🌐 Intl. Dept.</span>';
                if (h.international_dept && h.international_dept.languages) {
                    badges += '<span class="badge badge-intl">🗣 ' + h.international_dept.languages.slice(0,3).join('/') + '</span>';
                }

                var trustHtml = '';
                if (h.trust) {
                    trustHtml += '<div class="hospital-info" style="font-size:0.82rem;color:#207948">✓ Data verified ' + formatVerified(h.trust.last_verified) + (h.trust.data_source ? ' · ' + formatSource(h.trust.data_source) : '') + '</div>';
                    var evidence = formatEvidence(h.trust.cross_validated);
                    if (evidence.length) {
                        trustHtml += '<div class="hospital-info" style="margin-top:4px;line-height:1.6;">' + evidence.join('') + '</div>';
                    }
                    if (h.trust.level) {
                        trustHtml += '<div class="hospital-info" style="font-size:0.78rem;color:#4b5565;margin-top:4px;"><strong>Trust:</strong> ' + formatLevel(h.trust.level) + ' — <a href="how-we-choose-hospitals.html" style="color:#1e3c72;text-decoration:underline;">How we verify →</a></div>';
                    }
                }

                var procHtml = '';
                var procList = procedureByHospital[h.id] || [];
                if (procList.length) {
                    procHtml = '<div class="hospital-procs" style="margin-top:8px;border-top:1px dashed #d9e2ec;padding-top:8px;">' +
                        '<div style="font-size:0.76rem;font-weight:700;color:#1e3c72;text-transform:uppercase;letter-spacing:.05em;margin-bottom:3px;">Representative procedures</div>' +
                        procList.slice(0, 3).map(function(pr) {
                            return '<div style="font-size:0.84rem;padding:2px 0;display:flex;justify-content:space-between;align-items:center;gap:8px;"><a href="procedures.html" style="color:#1e3c72;text-decoration:none;font-weight:600;">🩺 ' + pr.name + '</a><span style="color:#2e7d32;white-space:nowrap;font-weight:600;font-size:0.8rem;">' + (pr.price || '—') + '</span></div>';
                        }).join('') +
                        (procList.length > 3 ? '<div style="font-size:0.74rem;color:#8893a0;margin-top:3px;">+' + (procList.length - 3) + ' more — <a href="procedures.html" style="color:#1e3c72;">view all procedures</a></div>' : '') +
                    '</div>';
                }

                var tagHtml = (h.tags || []).slice(0, 6).map(function(t) {
                    return '<span class="hospital-tag">' + formatTag(t) + '</span>';
                }).join('');

                var phoneHtml = '';
                if (h.international_phone) {
                    phoneHtml = '<div class="hospital-info">📞 <strong>Intl:</strong> ' + h.international_phone;
                    if (h.phone) phoneHtml += ' | <strong>CN:</strong> ' + h.phone;
                    phoneHtml += '</div>';
                } else if (h.phone) {
                    phoneHtml = '<div class="hospital-info">📞 ' + h.phone + '</div>';
                }

                var airportHtml = '';
                if (h.airport_info) {
                    airportHtml = '<div class="hospital-info">✈️ ' + h.airport_info + '</div>';
                }

                return '<div class="hospital-card">' +
                    imageHtml +
                    '<div class="hospital-content">' +
                        '<div class="hospital-name">' + h.name + '</div>' +
                        '<div class="hospital-location">📍 ' + h.city + (h.district ? ', ' + h.district : '') + '</div>' +
                        (badges ? '<div class="badge-row">' + badges + '</div>' : '') +
                        trustHtml +
                        '<div class="hospital-info"><strong>' + (h.rank || '') + '</strong></div>' +
                        procHtml +
                        (h.estimated_wait_weeks ? '<div class="hospital-info">⏱ Est. wait: ' + h.estimated_wait_weeks + '</div>' : '') +
                        airportHtml +
                        phoneHtml +
                        (h.address ? '<div class="hospital-info" style="font-size:0.82rem;color:#8893a0">' + (h.name_zh || '') + ' — ' + h.address + '</div>' : '') +
                        (tagHtml ? '<div class="hospital-tags">' + tagHtml + '</div>' : '') +
                        '<div class="hospital-actions">' +
                            (h.website ? '<a href="' + h.website + '" target="_blank" rel="noopener" class="view-details-btn">🌐 Website</a>' : '') +
                            '<a href="/hospitals/' + h.id + '/" class="view-details-btn">📄 View Details</a>' +
                            '<a href="contact-new.html" class="view-details-btn">📋 Get Matched</a>' +
                        '</div>' +
                    '</div>' +
                '</div>';
            }).join('');
        }

        var EVIDENCE_LABELS = {
            'official_website': 'Official site',
            'public_ranking': 'Public ranking',
            'jci_verified': 'JCI verified',
            'who_reference': 'WHO reference',
            'direct_contact': 'Direct contact',
            'direct_channel_partner_documents': 'Channel docs',
            'pricing_manual': 'Pricing manual',
            'hospital_brochure': 'Hospital brochure'
        };
        function formatEvidence(list) {
            if (!list || !list.length) return [];
            return list.map(function(e) {
                var label = EVIDENCE_LABELS[e] || e.replace(/_/g, ' ');
                return '<span style="display:inline-block;background:#eef6ef;color:#2e7d32;border:1px solid #c8e6c9;border-radius:999px;padding:1px 8px;font-size:0.72rem;font-weight:600;margin:2px 4px 2px 0;">' + label + ' ✓</span>';
            });
        }
        function formatSource(s) {
            return { official: 'Official source', multi_source: 'Multi-source', dual_source: 'Dual-source', single_source: 'Single-source' }[s] || s;
        }
        function formatLevel(l) {
            return { very_high: 'Very High', high: 'High', medium_high: 'Medium-High', medium: 'Medium' }[l] || l;
        }

        function formatVerified(dateStr) {
            if (!dateStr) return '';
            var d = new Date(dateStr);
            if (isNaN(d.getTime())) return dateStr;
            var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
            return months[d.getMonth()] + ' ' + d.getFullYear();
        }

        function hashCode(str) {
            var hash = 0, i, chr;
            for (i = 0; i < str.length; i++) {
                chr = str.charCodeAt(i);
                hash = ((hash << 5) - hash) + chr;
                hash |= 0;
            }
            return Math.abs(hash);
        }

        function setFilter(kind, value) {
            if (kind === 'region') activeRegion = value;
            if (kind === 'specialty') activeSpecialty = value;
            render();
        }

        searchInput.addEventListener('input', function() {
            activeSearch = this.value;
            render();
        });

        regionTabs.addEventListener('click', function(e) {
            var btn = e.target.closest('.region-tab');
            if (!btn) return;
            regionTabs.querySelectorAll('.region-tab').forEach(function(b) { b.classList.remove('active'); });
            btn.classList.add('active');
            setFilter('region', btn.dataset.region);
        });

        specialtyTags.addEventListener('click', function(e) {
            var btn = e.target.closest('.specialty-tag');
            if (!btn) return;
            specialtyTags.querySelectorAll('.specialty-tag').forEach(function(b) { b.classList.remove('active'); });
            btn.classList.add('active');
            setFilter('specialty', btn.dataset.specialty || '');
        });

        grid.addEventListener('click', function(e) {
            var tag = e.target.closest('.hospital-tag');
            if (!tag) return;
            activeSpecialty = tag.textContent.replace(/\s+/g, '-').toLowerCase();
            var tags = specialtyTags.querySelectorAll('.specialty-tag');
            tags.forEach(function(b) { b.classList.remove('active'); });
            var match = specialtyTags.querySelector('[data-specialty="' + activeSpecialty + '"]');
            if (match) match.classList.add('active');
            searchInput.value = '';
            activeSearch = '';
            activeRegion = 'all';
            regionTabs.querySelectorAll('.region-tab').forEach(function(b) { b.classList.remove('active'); });
            var allTab = regionTabs.querySelector('[data-region="all"]');
            if (allTab) allTab.classList.add('active');
            render();
        });

        fetchHospitals();
    })();
    </script>

